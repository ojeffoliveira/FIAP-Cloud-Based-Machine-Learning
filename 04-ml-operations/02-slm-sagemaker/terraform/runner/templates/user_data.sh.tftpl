#!/bin/bash
# user-data do runner self-hosted do GitHub Actions (Lab 04.2). Roda uma vez
# no boot via cloud-init. Dois caminhos de registro, os dois têm que
# funcionar (decisão D44):
#   - AUTOMÁTICO (default): se `make runner-token` já gravou o token como
#     SecureString no SSM Parameter Store antes do apply, a seção 6.1 lê,
#     registra e apaga o parâmetro — sem sessão SSM interativa, sem login do
#     GitHub no Codespaces.
#   - MANUAL (fallback, parâmetro ausente ou registro automático falhou):
#     scripts/register_runner.sh, via sessão SSM Session Manager.
# Em nenhum caminho o token passa por state/log do Terraform: o Terraform só
# conhece o NOME do parâmetro (var.runner_token_ssm_parameter), nunca o
# valor. Ver 01_RESEARCH_FINDINGS_AND_DECISIONS.md §9.
#
# Idempotente: cada etapa checa se o resultado já existe antes de repetir.
#
# Decisão D8: security group só abre egress 443, nunca 80 — por isso este
# script nunca chama apt-get/installdependencies.sh. Medição real (A3/A5,
# mesma AMI Canonical) confirmou de fábrica: git, gnupg, ca-certificates, e as
# libs nativas do runner (libicu70, libssl3, libkrb5, zlib1g). Faltam: unzip
# (substituído por `python3 -m zipfile`), jq e make (binário/pacote oficial
# com checksum, sem apt).

set -o errexit -o pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1
echo "=== user-data iniciado: $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# ---------------------------------------------------------------------------
# 1. SSM Agent
# ---------------------------------------------------------------------------
# A AMI Canonical 22.04 já entrega o snap amazon-ssm-agent ativo de fábrica —
# provado pelo agente A3 na conta Academy real (Online no
# describe-instance-information em menos de 3min10s, sem nenhum user-data).
# Este bloco só existe como rede de segurança caso uma atualização futura da
# AMI mude esse comportamento.
if ! snap services amazon-ssm-agent 2>/dev/null | grep -q "active"; then
  echo "SSM Agent não está ativo via snap; instalando/iniciando."
  snap install amazon-ssm-agent --classic || true
  snap start amazon-ssm-agent || true
fi

# ---------------------------------------------------------------------------
# 2. jq — único binário sem alternativa nativa na AMI, via download oficial
#    com checksum SHA-256 (egress 443, sem apt)
# ---------------------------------------------------------------------------
jq_version="${jq_version}"
jq_sha256="${jq_linux_amd64_sha256}"

if ! command -v jq >/dev/null 2>&1; then
  echo "Instalando jq $${jq_version}."
  curl -fsSL -o /usr/local/bin/jq \
    "https://github.com/jqlang/jq/releases/download/jq-$${jq_version}/jq-linux-amd64"
  echo "$${jq_sha256}  /usr/local/bin/jq" | sha256sum -c -
  chmod 0755 /usr/local/bin/jq
else
  echo "jq já presente, pulando."
fi

# ---------------------------------------------------------------------------
# 3. AWS CLI v2 — download oficial + verificação de assinatura GPG
# ---------------------------------------------------------------------------
# gnupg já vem de fábrica. A AWS não publica SHA-256 estático para o bundle
# "current" (muda a cada patch); o guia oficial recomenda verificar a
# assinatura .sig, que é o mecanismo de integridade que a AWS mantém aqui.
if ! command -v aws >/dev/null 2>&1; then
  echo "Instalando AWS CLI v2."
  workdir_cli=$(mktemp -d)
  cd "$workdir_cli"

  curl -fsSL -o awscliv2.zip "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"
  curl -fsSL -o awscliv2.zip.sig "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip.sig"

  cat > aws_pubkey.asc <<'AWS_CLI_GPG_PUBLIC_KEY'
${aws_cli_gpg_public_key}
AWS_CLI_GPG_PUBLIC_KEY

  export GNUPGHOME
  GNUPGHOME=$(mktemp -d)
  gpg --batch --import aws_pubkey.asc
  gpg --batch --list-keys "${aws_cli_gpg_key_fingerprint}" >/dev/null

  gpg --batch --verify awscliv2.zip.sig awscliv2.zip

  # unzip não vem de fábrica na AMI e não instalamos via apt (egress 443-only);
  # python3 (esse sim de fábrica) resolve sem dependência nova.
  python3 -m zipfile -e awscliv2.zip .

  # python3 -m zipfile descarta o bit de execução; sem chmod o install
  # aborta com "Permission denied" e o resto do provisionamento não acontece.
  chmod -R u+x ./aws
  ./aws/install

  cd /
  rm -rf "$workdir_cli" "$GNUPGHOME"
  unset GNUPGHOME
else
  echo "AWS CLI já instalada, pulando."
fi

# ---------------------------------------------------------------------------
# 4. Terraform pinado — download oficial + checksum SHA-256
# ---------------------------------------------------------------------------
# Mesma versão de versions.tf: o runner precisa falar a mesma versão que o
# Codespaces fala com terraform/slm/, senão o plan do pipeline V2 diverge.
terraform_version="${terraform_version}"
terraform_sha256="${terraform_linux_amd64_sha256}"

if ! (command -v terraform >/dev/null 2>&1 && terraform version | head -1 | grep -q "v$${terraform_version}"); then
  echo "Instalando Terraform $${terraform_version}."
  workdir_tf=$(mktemp -d)
  cd "$workdir_tf"

  curl -fsSL -o terraform.zip \
    "https://releases.hashicorp.com/terraform/$${terraform_version}/terraform_$${terraform_version}_linux_amd64.zip"
  echo "$${terraform_sha256}  terraform.zip" | sha256sum -c -

  python3 -m zipfile -e terraform.zip .
  install -m 0755 terraform /usr/local/bin/terraform

  cd /
  rm -rf "$workdir_tf"
else
  echo "Terraform $${terraform_version} já instalado, pulando."
fi

# ---------------------------------------------------------------------------
# 5. make — pacote .deb oficial do Ubuntu 22.04 (jammy), via HTTPS direto do
#    archive, sem apt-get e sem gcc/toolchain de compilação
# ---------------------------------------------------------------------------
# BUG REAL na execução do pipeline V2: job no runner falhou com "exit code
# 127" em `make pipeline-preflight`/`make clean` — esta AMI não tem make de
# fábrica. make só interpreta o Makefile e chama binários já instalados
# (Python, Terraform, aws), sem precisar compilar nada.
#
# archive.ubuntu.com/security.ubuntu.com servem o pool de pacotes por HTTPS
# 443 (decisão D8) — dá para baixar o .deb oficial sem apt-get/mirrorlist. O
# SHA-256 em var.make_deb_sha256 foi conferido por download real e cruzado
# com o Packages.gz assinado do próprio Ubuntu. Única dependência é libc6
# (>= 2.34), já de fábrica nesta AMI (glibc 2.35).
make_version="${make_version}"
make_sha256="${make_deb_sha256}"

if ! command -v make >/dev/null 2>&1; then
  echo "Instalando make $${make_version} (pacote .deb oficial do Ubuntu, via HTTPS)."
  workdir_make=$(mktemp -d)
  cd "$workdir_make"

  curl -fsSL -o make.deb \
    "https://archive.ubuntu.com/ubuntu/pool/main/m/make-dfsg/make_$${make_version}_amd64.deb"
  echo "$${make_sha256}  make.deb" | sha256sum -c -

  dpkg -i make.deb

  cd /
  rm -rf "$workdir_make"
else
  echo "make já presente, pulando."
fi

# ---------------------------------------------------------------------------
# 6. GitHub Actions runner — download pinado + checksum
#    e, se possível, registro automático via SSM Parameter Store (decisão D44)
# ---------------------------------------------------------------------------
runner_version="${runner_version}"
runner_sha256="${runner_linux_x64_sha256}"
runner_dir=/opt/actions-runner
runner_user=actions-runner

if ! id -u "$runner_user" >/dev/null 2>&1; then
  # config.sh recusa rodar como root (sem RUNNER_ALLOW_RUNASROOT). Validação
  # real provou que rodar como "ubuntu" (ou root) quebra com stack trace .NET
  # de permissão — precisa ser um usuário de serviço dedicado (uid de sistema).
  useradd --system --create-home --shell /usr/sbin/nologin "$runner_user"
fi

if [ ! -f "$runner_dir/.provisionado" ]; then
  echo "Instalando GitHub Actions runner $${runner_version} em $runner_dir."
  mkdir -p "$runner_dir"
  cd "$runner_dir"

  curl -fsSL -o runner.tar.gz \
    "https://github.com/actions/runner/releases/download/v$${runner_version}/actions-runner-linux-x64-$${runner_version}.tar.gz"
  echo "$${runner_sha256}  runner.tar.gz" | sha256sum -c -

  tar xzf runner.tar.gz
  rm runner.tar.gz

  # NÃO chamamos ./bin/installdependencies.sh de propósito: roda apt-get, que
  # falha sem egress 80 (decisão D8). Medição real (A5, mesma AMI, egress
  # 443-only) confirmou via ldconfig -p que libicu70, libssl3, libkrb5 e
  # zlib1g (libs do runtime .NET do runner) já vêm de fábrica. Falta só
  # liblttng-ust (tracing opcional de diagnóstico) — sua ausência não impede
  # o runner de rodar, no máximo gera um aviso no log.
  chown -R "$runner_user":"$runner_user" "$runner_dir"

  # -------------------------------------------------------------------------
  # 6.1 Registro automático via SSM Parameter Store (decisão D44)
  # -------------------------------------------------------------------------
  # Regra crítica: o TERRAFORM NUNCA lê o valor do token, só o NOME do
  # parâmetro (var.runner_token_ssm_parameter, não é segredo). Um
  # `data "aws_ssm_parameter"` aqui vazaria o valor no state em S3 (spec §9).
  # Só esta instância, via AWS CLI, lê e apaga o valor.
  #
  # FALLBACK OBRIGATÓRIO: se o parâmetro não existir ou o registro falhar, o
  # boot NÃO aborta — runner fica instalado sem registro, log explica o
  # caminho manual (scripts/register_runner.sh via sessão SSM).
  runner_token_param="${runner_token_ssm_parameter}"
  github_repo_url_boot="https://github.com/${github_repository_owner}/${github_repository_name}"

  if [ -f "$runner_dir/.credentials" ]; then
    echo "Runner já tem .credentials (registrado antes); registro automático pulado."
  elif registration_token=$(aws ssm get-parameter --name "$runner_token_param" \
         --with-decryption --query "Parameter.Value" --output text 2>/dev/null); then
    # Daqui até o `unset`, uma variável de shell guarda o token — nunca ligar
    # tracing (set -x) neste trecho, nunca ecoar essa variável.
    set +o xtrace

    imds_token=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
      -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    instance_id=$(curl -fsS -H "X-aws-ec2-metadata-token: $imds_token" \
      "http://169.254.169.254/latest/meta-data/instance-id")
    runner_name="academy-slm-deploy-$${instance_id}"

    echo "Parametro $runner_token_param encontrado; registrando runner '$${runner_name}' automaticamente."
    cd "$runner_dir"

    # RISCO RESIDUAL DOCUMENTADO (mesmo aceito em scripts/register_runner.sh):
    # config.sh só aceita o token pela flag --token, sem alternativa de env
    # var/stdin (conferido, não é suposição). Fica visível em ps/proc por uma
    # janela curta; mitigado por unset imediato e apagar o parâmetro a seguir.
    if runuser -u "$runner_user" -- ./config.sh \
         --unattended \
         --replace \
         --ephemeral \
         --url "$github_repo_url_boot" \
         --token "$registration_token" \
         --name "$${runner_name}" \
         --labels "self-hosted,linux,x64,academy-slm-deploy"; then
      unset registration_token
      echo "Registro automático concluído; instalando e iniciando o servico systemd."
      ./svc.sh install "$runner_user"
      ./svc.sh start
    else
      unset registration_token
      echo "AVISO: registro automatico falhou (config.sh saiu com erro)." >&2
      echo "Runner fica instalado, sem registro. Registre manualmente com" >&2
      echo "scripts/register_runner.sh dentro de uma sessao SSM Session Manager." >&2
    fi

    echo "Apagando o parametro $runner_token_param no SSM (token de uso unico, nunca fica guardado)."
    aws ssm delete-parameter --name "$runner_token_param" \
      || echo "AVISO: nao foi possivel apagar $runner_token_param; apague manualmente." >&2
  else
    echo "Parametro $runner_token_param nao encontrado; registro automatico pulado."
    echo "Registre manualmente com scripts/register_runner.sh dentro de uma sessao SSM Session Manager"
    echo "(use o output ssm_start_session_command de 'terraform -chdir=terraform/runner output')."
  fi

  unset runner_token_param

  # Marcador que runner_status.py/register_runner.sh checam: provisionamento
  # (instalação + tentativa de registro, sucesso ou fallback) terminou.
  date -u +%Y-%m-%dT%H:%M:%SZ > "$runner_dir/.provisionado"
  chown "$runner_user":"$runner_user" "$runner_dir/.provisionado"
else
  echo "GitHub Actions runner já provisionado, pulando."
fi

echo "=== user-data concluído: $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
if [ -f "$runner_dir/.credentials" ]; then
  echo "Runner instalado em $runner_dir e JÁ REGISTRADO (registro automático via SSM)."
else
  echo "Runner instalado em $runner_dir, AINDA NÃO REGISTRADO."
  echo "Registro automático via SSM não rodou ou falhou (ver mensagens acima)."
  echo "Registro manual: scripts/register_runner.sh, executado via SSM Session Manager."
fi

