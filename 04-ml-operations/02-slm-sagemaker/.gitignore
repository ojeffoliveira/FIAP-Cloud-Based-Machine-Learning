# Credencial nunca entra neste repositório.
.env
.env.*
.aws/
*.pem
*.ppk

# Backend/config gerado localmente (sufixo, account id) — nunca versionado,
# recalculado a cada `make backend`/`make doctor`.
.generated/

# State dos dois stacks Terraform (runner e slm) descreve infraestrutura viva
# e pode conter valor sensível.
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
.terraform/
*.tfplan
# `terraform plan -out=tfplan-runner` gera arquivo sem extensão, que o padrão
# acima não pega — e plano de execução nunca deve ser versionado.
tfplan*
terraform.tfvars
crash.log
crash.*.log

# Tudo que é gerado em tempo de execução (evidence, dataset, predições).
artifacts/

# O GGUF nunca é versionado — baixado do Hugging Face Hub e sincronizado
# direto para o S3, nunca passa por `artifacts/` nem pelo git. Pesos em
# safetensors (formato intermediário de alguns releases no HF) têm a mesma
# regra: nunca no git.
*.gguf
*.safetensors
*.tar.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.mypy_cache/
.ruff_cache/
.bandit/
.scannerwork/

.DS_Store

# A regra `*Icon*` do .gitignore da raiz existe para o arquivo de recurso
# `Icon\r` do macOS, mas com core.ignorecase=true ela casa com o diretório
# `icones/` inteiro — sem esta negação escopada os ícones oficiais da AWS
# usados no diagrama de arquitetura nunca entram no versionamento.
!diagramas/icones/
