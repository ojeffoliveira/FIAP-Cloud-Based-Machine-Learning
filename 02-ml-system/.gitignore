# Credencial nunca entra neste repositório. As credenciais do Academy vivem no
# ambiente ou num profile da AWS fora da árvore de trabalho.
.env
.env.*
.aws/
*.pem
*.ppk

# O state do Terraform descreve infraestrutura viva e pode conter valor sensível.
terraform.tfstate
terraform.tfstate.*
.terraform/
terraform.tfvars
crash.log
crash.*.log

# Arquivo de passagem de bastão, escrito por scripts/wait_training.py no `make apply`.
terraform/artifact.auto.tfvars.json

# Tudo que é gerado em tempo de execução: dataset, predições, evidências.
artifacts/
build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.mypy_cache/
.ruff_cache/
